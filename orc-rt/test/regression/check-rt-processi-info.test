# REQUIRES: system-darwin || system-windows
#
# RUN: orc-rt-process-info-check --print-triple --print-cpu-features --print-page-size  \
# RUN:   | FileCheck %s -DTRIPLE=%host_triple

# CHECK: [[TRIPLE]]
# CHECK-NEXT: {{4096|16384}}
# DARWIN-NEXT: {{(\+[a-z0-9_.]+,)*\+neon(,\+[a-z0-9_.]+)*}}
# WINDOWS-NEXT: {{(\+[a-z0-9_.]+,)*\+sse2(,\+[a-z0-9_.]+)*}}
